        <dc:subject>osi</dc:subject>
        <dc:title>Guide to secure web services</dc:title>
        <dc:date>2007</dc:date>
        <dc:identifier>DOI 10.6028/NIST.SP.800-95</dc:identifier>
        <dc:identifier>
            <dcterms:URI>
                <rdf:value>https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nistspecialpublication800-95.pdf</rdf:value>
            </dcterms:URI>
        </dc:identifier>
