    </z:Attachment>
    <bib:Article rdf:about="https://www.nature.com/articles/s41598-023-48845-4">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:2045-2322"/>
        <bib:authors>
