    <bib:Article rdf:about="#item_28">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
           <bib:Journal></bib:Journal>
        </dcterms:isPartOf>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Bar-Gad</foaf:surname>
                        <foaf:givenName>Izhar</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Klein</foaf:surname>
                        <foaf:givenName>Amit</foaf:givenName>
                    </foaf:Person>
